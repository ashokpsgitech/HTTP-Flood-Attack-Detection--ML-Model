# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large model binaries
models/*.joblib

# Raw dataset CSVs (too large for GitHub - use .rar files instead)
datasets/*.csv
# Allow .rar files in datasets/ for version control
!datasets/*.rar

# Prediction files and matrices
results/predictions_*.csv
results/confusion_matrices/

# OS metadata
.DS_Store
Thumbs.db
